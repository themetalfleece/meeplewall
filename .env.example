# Copy to .env.local and fill in. Every variable is required: nothing falls back to a default.

# Postgres. The value below is the compose Postgres from infra/docker-compose.yml. The
# packages/db tests also read it and skip when it is unset or unreachable.
DATABASE_URL=postgres://boardgames:boardgames@localhost:5432/boardgames

# Object storage. One set of variables for both targets: Cloudflare R2 in production, the
# compose minio locally. The values below are the local minio defaults from
# infra/docker-compose.yml.

# S3 API endpoint. For R2 this is https://<account id>.r2.cloudflarestorage.com.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=board-games
# Where objects are served publicly, without a trailing key. For R2, the bucket's custom domain
# or r2.dev URL.
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/board-games
# true for minio, which serves buckets as a path. false for R2.
STORAGE_FORCE_PATH_STYLE=true

# BoardGameGeek. Sent as the User-Agent on every request to BGG, so name the app and give a way
# to reach whoever runs it.
BGG_USER_AGENT=board-games (+https://github.com/themetalfleece/board-games)
