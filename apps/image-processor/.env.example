# Copy to apps/image-processor/.env.local and fill in. Every variable is required: nothing falls
# back to a default. The worker suite reads DATABASE_URL and STORAGE_* from the same file.

# Postgres. The value below is the compose Postgres from docker-compose.yml.
DATABASE_URL=postgres://meeplewall:meeplewall@localhost:5432/meeplewall

# Object storage: Cloudflare R2 in production, the compose minio locally. The values below are the
# local minio defaults from docker-compose.yml.

# S3 API endpoint. For R2 this is https://<account id>.r2.cloudflarestorage.com.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=meeplewall
# Where objects are served publicly, without a trailing key. For R2, the bucket's custom domain or
# r2.dev URL.
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/meeplewall
# true for minio, which serves buckets as a path. false for R2.
STORAGE_FORCE_PATH_STYLE=true

# Base URL the worker reaches apps/web on. After each processed image it POSTs to
# /api/internal/revalidate there so the game's pages re-render.
WEB_INTERNAL_URL=http://localhost:3000
# Shared secret the worker sends to that route as a bearer token. At least 32 characters; generate
# one with `openssl rand -hex 32`. Must match the value in apps/web/.env.local.
INTERNAL_REVALIDATE_SECRET=
# Port the worker serves GET /healthz on.
IMAGE_PROCESSOR_HEALTH_PORT=8080
