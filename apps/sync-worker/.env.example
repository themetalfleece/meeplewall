# Copy to apps/sync-worker/.env.local and fill in. Every variable is required: nothing falls back
# to a default.

# Postgres. The value below is the compose Postgres from docker-compose.yml.
DATABASE_URL=postgres://meeplewall:meeplewall@localhost:5432/meeplewall

# Sent as the User-Agent on every request to BGG, so name the app and give a way to reach whoever
# runs it.
BGG_USER_AGENT=meeplewall (+https://meeplewall.com)

# Bearer token of the application registered with BGG at boardgamegeek.com/applications. XMLAPI2
# is the only BGG API that lists a user's collection, and it answers 401 without one.
BGG_API_TOKEN=

# Port the worker serves GET /healthz on.
SYNC_WORKER_HEALTH_PORT=8081

# The least severe level written as a JSON log line: info, warn or error. Errors are always written.
LOG_LEVEL=info
