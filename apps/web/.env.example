# Copy to apps/web/.env.local and fill in. Every variable is required: nothing falls back to a
# default.

# The site's public origin, with no trailing path. Sets metadataBase, so social images and
# canonical links resolve against it. Needed at build time too, since static pages are rendered
# then; pass the same value to both.
SITE_URL=http://localhost:3000

# Postgres. The value below is the compose Postgres from infra/docker-compose.yml.
DATABASE_URL=postgres://boardgames:boardgames@localhost:5432/boardgames

# Where processed images are served from, without a trailing key. For R2, the bucket's custom
# domain or r2.dev URL. The value below is the compose minio bucket.
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/board-games

# Sent as the User-Agent on every request to BGG, so name the app and give a way to reach whoever
# runs it.
BGG_USER_AGENT=board-games (+https://github.com/themetalfleece/board-games)

# Bearer token of the application registered with BGG at boardgamegeek.com/applications. XMLAPI2
# is the only BGG API that lists a user's collection, and it answers 401 without one. Server-only.
BGG_API_TOKEN=

# Shared secret the image processor sends to POST /api/internal/revalidate as a bearer token. At
# least 32 characters; generate one with `openssl rand -hex 32`. Must match the value in
# apps/image-processor/.env.local. Server-only.
INTERNAL_REVALIDATE_SECRET=
