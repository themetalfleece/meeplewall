# The Next.js app as a standalone Node server. Build from the repo root:
#
#   docker build -f infra/Dockerfile.web --build-arg SITE_URL=https://meeplewall.com -t meeplewall-web .
#
# SITE_URL is needed at build time because static pages are rendered then; give the container the
# same value. At runtime it reads SITE_URL, DATABASE_URL, STORAGE_PUBLIC_BASE_URL, BGG_USER_AGENT,
# BGG_API_TOKEN and INTERNAL_REVALIDATE_SECRET (see apps/web/.env.example), and serves
# GET /healthz on PORT.

# Node's current LTS line. Pin the exact release, never a floating tag.
FROM node:24.22.0-trixie-slim AS build
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /repo
COPY . .
# Installs and builds only the app and the workspace packages it depends on.
RUN pnpm install --frozen-lockfile --filter "@meeplewall/web..."
ARG SITE_URL
RUN SITE_URL="$SITE_URL" pnpm --filter "@meeplewall/web..." build

FROM node:24.22.0-trixie-slim
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
WORKDIR /app
# The standalone bundle keeps the monorepo layout, so the server sits at apps/web/server.js. It
# serves .next/static and public itself once they are copied beside it.
COPY --from=build --chown=node:node /repo/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /repo/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
# The slim image has no curl, so the probe uses Node's fetch.
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch(`http://127.0.0.1:${process.env.PORT}/healthz`).then((response) => process.exit(response.ok ? 0 : 1), () => process.exit(1))"]
CMD ["node", "apps/web/server.js"]
