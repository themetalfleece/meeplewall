# Copy to packages/boardgamegeek/.env.local for the dev-fetch script and the live suites.

# Sent as the User-Agent on every request to BGG, so name the app and give a way to reach whoever
# runs it.
BGG_USER_AGENT=board-games (+https://github.com/themetalfleece/board-games)

# Bearer token of the application registered with BGG at boardgamegeek.com/applications. Only the
# live XMLAPI2 collection suite needs it; it skips while this is empty.
BGG_API_TOKEN=
