{
  "name": "@board-games/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/migrations"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.ts"
  },
  "devDependencies": {
    "@board-games/config": "workspace:*",
    "@types/node": "catalog:dev",
    "drizzle-kit": "catalog:dev",
    "eslint": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "dependencies": {
    "@types/pg": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  }
}
