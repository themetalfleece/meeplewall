# Copy to packages/storage/.env.local for the minio round trip in storage.e2e.test.ts. It skips
# when these are unset or minio is down. The values below are the local minio defaults from
# infra/docker-compose.yml.

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=meeplewall
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/meeplewall
STORAGE_FORCE_PATH_STYLE=true
